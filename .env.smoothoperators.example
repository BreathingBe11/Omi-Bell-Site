# Smooth Operators — environment variables (template; contains NO secrets).
# Set these in Vercel: Project -> Settings -> Environment Variables.
# For local development, export them in your shell before `npm run so:dev`.

# --- Database (server only) -------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
SO_DATABASE_URL=

# --- Supabase Auth + Storage -------------------------------------------------
# Already used by the site; the anon key is public by design, the service role key is server-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket created by supabase/smooth_operators.sql
SO_STORAGE_BUCKET=smooth-operators

# Google OAuth "Web application" client ID (public). Turns on Google's own sign-in button on omibell.com.
# The same client ID (and its secret) also go in Supabase -> Authentication -> Providers -> Google.
SO_GOOGLE_CLIENT_ID=

# --- Stripe (start with TEST keys: sk_test_...) -------------------------------
STRIPE_SECRET_KEY=
# Developers -> Webhooks -> your endpoint -> Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Optional: pre-created one-time Prices. If set, their amounts must equal the admin prices
# (99900 / 149700) or checkout refuses to start. If unset, the price is sent inline.
STRIPE_PRICE_ID_INTRO=
STRIPE_PRICE_ID_REGULAR=
# Optional: "true" to enable Stripe Tax on checkout (configure Stripe Tax first).
STRIPE_AUTOMATIC_TAX=
# Optional: pin an API version; otherwise the account default is used.
STRIPE_API_VERSION=
# Line shown above Stripe's Pay button (default mentions Omi’s World Media, the Stripe account name). Set empty to hide.
SO_CHECKOUT_NOTE=
# Optional card-statement suffix, e.g. SMOOTH OPS (requires a shortened descriptor in Stripe settings).
SO_STATEMENT_SUFFIX=
# Test-mode checkout is refused on the production deployment unless this is "true".
SO_ALLOW_TEST_CHECKOUT=

# --- Email (Resend, already used by the site) ---------------------------------
RESEND_API_KEY=
# off (default) | sandbox (everything goes to SO_SANDBOX_EMAIL) | live
SO_EMAIL_DELIVERY=off
SO_SANDBOX_EMAIL=
SO_EMAIL_FROM=Omi Bell <hello@omibell.com>
SO_EMAIL_REPLY_TO=
# Resend -> Webhooks -> endpoint https://<domain>/api/smoothoperators-webhook (email.sent, email.delivered,
# email.bounced, email.complained, email.failed). Signing secret (whsec_...). Without it, the admin shows
# "accepted by email provider" as the last known status.
RESEND_WEBHOOK_SECRET=

# --- Site ----------------------------------------------------------------------
# Absolute origin used for Stripe return URLs and email links, e.g. https://www.omibell.com
SO_SITE_URL=
# Existing admin login secret (already set for /admin).
SESSION_SECRET=
