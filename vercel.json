{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' cdn.jsdelivr.net fonts.googleapis.com https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' fonts.googleapis.com fonts.gstatic.com https://accounts.google.com/gsi/style; img-src 'self' data: blob: https:; font-src 'self' fonts.gstatic.com; media-src 'self' blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co https://connect.mailerlite.com https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/smoothoperators/:section(app|admin|checkout|login)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/so/:path*",
      "destination": "/api/smoothoperators?route=:path*"
    },
    {
      "source": "/smoothoperators",
      "destination": "/api/smoothoperators?route=page/landing"
    },
    {
      "source": "/smoothoperators/terms",
      "destination": "/api/smoothoperators?route=page/terms"
    },
    {
      "source": "/smoothoperators/privacy",
      "destination": "/api/smoothoperators?route=page/privacy"
    },
    {
      "source": "/smoothoperators/admin/:path*",
      "destination": "/smoothoperators/admin"
    },
    {
      "source": "/smoothoperators/app/:path*",
      "destination": "/smoothoperators/app"
    },
    {
      "source": "/smoothoperators/checkout",
      "destination": "/smoothoperators/app"
    },
    {
      "source": "/smoothoperators/checkout/:path*",
      "destination": "/smoothoperators/app"
    },
    {
      "source": "/smoothoperators/login",
      "destination": "/smoothoperators/app"
    },
    {
      "source": "/smoothoperators/login/:path*",
      "destination": "/smoothoperators/app"
    }
  ]
}
